# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Google Maps Platform（地図表示・SC-02, SC-12, SC-13, SC-19で使用。フロントに露出するためリファラー制限必須）
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Places API / Geocoding API（スポット検索・逆ジオコーディング。サーバー専用、NEXT_PUBLIC_を付けない）
GOOGLE_PLACES_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# TypeSafe AI（Jev。通報の優先度付けを試すため。2026-10-04 時点では検討中で、本番では未使用）
# サーバー専用。NEXT_PUBLIC_ を付けない（投稿本文を送るため、ブラウザから呼ばない）
TYPESAFE_API_KEY=

# Vercel Cron の合言葉（#714。操作ログを毎日消す窓口を守る）
# サーバー専用。設定しないと窓口は誰も通さない（＝消す処理が動かない）
# Vercel の管理画面で設定すると、Vercel が Authorization: Bearer <値> を付けて呼んでくれる
CRON_SECRET=
